# Browser API key for HERE Discover and Public Transit Routing.
# In HERE Access Manager, restrict browser use to:
#   https://keithah.github.io
#   http://localhost:5173
#   http://127.0.0.1:4173
VITE_HERE_API_KEY=

# 511 Open Data token from https://511.org/open-data/token.
# Enables nearby departure boards and SF service alerts. Without it, curated
# property guidance and static fallback times remain available.
VITE_API_511_KEY=
