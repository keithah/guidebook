# Free key from https://511.org/open-data/token — enables live Muni/BART
# departures in src/lib/transit511.js. Without it (or without real 511 stop
# codes in sfcottage.json), the app falls back to the static times already
# in the property data.
VITE_API_511_KEY=

# Browser API key for HERE Discover and Public Transit Routing.
# Restrict it to trusted production/development domains in HERE Access Manager.
VITE_HERE_API_KEY=
